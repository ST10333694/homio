<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Property"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/homio_navy"
            android:layout_marginBottom="20dp"/>

        <EditText
            android:id="@+id/etAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Address"/>

        <EditText
            android:id="@+id/etPropertyType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Property Type (e.g. Apartment, House)"
            android:layout_marginTop="16dp"/>

        <EditText
            android:id="@+id/etRooms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Number of Rooms"
            android:inputType="number"
            android:layout_marginTop="16dp"/>

        <EditText
            android:id="@+id/etRentAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Monthly Rent Amount (R)"
            android:inputType="numberDecimal"
            android:layout_marginTop="16dp"/>

        <EditText
            android:id="@+id/etDepositAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Deposit Amount (R)"
            android:inputType="numberDecimal"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Property images/videos can be added in a later version."
            android:textSize="11sp"
            android:textColor="@color/homio_gray"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btnSaveProperty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Property"
            android:backgroundTint="@color/homio_purple"
            android:textColor="@color/white"
            android:layout_marginTop="24dp"/>

    </LinearLayout>
</ScrollView>
